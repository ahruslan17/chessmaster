# Database
DATABASE_URL=postgresql+asyncpg://chess:chess@localhost:5432/chess_master

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=1

# Stockfish
STOCKFISH_PATH=/usr/local/bin/stockfish
STOCKFISH_DEPTH=22
STOCKFISH_MULTIPV=5
# Time limit (seconds) per position - use for faster analysis; overrides depth when set
STOCKFISH_TIME_LIMIT=5
STOCKFISH_THREADS=4

# LLM
LLM_MODEL=openai/gpt-6.1-sol
# Optional comparison model; not called automatically
LLM_ALTERNATIVE_MODEL=openai/gpt-5.6-terra
LLM_API_KEY=sk-your-key-here
LITELLM_BASE_URL=https://litellm.gearwap.ru/v1

# App
APP_ENV=development
APP_DEBUG=true

# Optional public-preview access gate. Production requires a long random secret.
ACCESS_CONTROL_ENABLED=false
ACCESS_CODE_SECRET=
ACCESS_SESSION_MINUTES=15
ACCESS_COOKIE_SECURE=false
PUBLIC_MAX_GAMES_PER_SESSION=1
PUBLIC_MAX_ACTIVE_ENGINE_JOBS=1
